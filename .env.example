# ==============================================================================
# Among Us: Live Deduction — Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local and populate with your actual values.
# NEVER commit real credentials or secrets to version control.

# Database Connection (PostgreSQL 16)
# Local development default:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/among_us_deduction?schema=public"
# In Docker production compose, the database service hostname is 'db':
# DATABASE_URL="postgresql://tournament_user:YOUR_STRONG_PASSWORD@db:5432/among_us_deduction?schema=public"

# NextAuth.js Authentication Configuration
# Development:
NEXTAUTH_URL="http://localhost:3000"
# Production (must be your canonical public HTTPS domain, without trailing slash):
# NEXTAUTH_URL="https://tournament.yourdomain.com"

# NextAuth Secret: Used to encrypt JWT session cookies.
# Generate a strong 32+ character random secret in production using: openssl rand -base64 32
NEXTAUTH_SECRET="change-this-to-a-secure-random-32-character-secret-in-production"

# Application Environment
# Options: "development" | "production" | "test"
# In production, security headers (including HSTS) and error sanitization are activated.
NODE_ENV="development"
PORT="3000"

